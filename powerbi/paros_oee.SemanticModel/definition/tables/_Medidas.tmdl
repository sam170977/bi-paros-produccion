table _Medidas
	lineageTag: 4061af70-9fdd-4d0f-97bd-be0202713a69

	measure Disponibilidad = 1 - DIVIDE ( [Min Paro], [Min Programados] )
		lineageTag: 473e9e46-2270-4d9f-aa97-0e541752a311

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Horas Paro' = DIVIDE ( [Min Paro], 60 )
		lineageTag: 27f77998-5615-44dc-9a6c-86508291479a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Horas Trabajadas' = SUM ( fact_produccion_turno[horas_trabajadas] )
		lineageTag: abbd0fc2-837b-45bd-bc74-1b8c4e200999

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Min Paro' = SUM ( fact_produccion_turno[min_paro_total] )
		lineageTag: 5cd272ac-3cf0-4771-9c17-d2f3ffa76f5e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Min Programados' = [Horas Trabajadas] * 60
		lineageTag: df24af45-ae5a-4bdb-8822-7bda06b17602

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Pacas Producidas' = SUM ( fact_produccion_turno[pacas_producidas] )
		lineageTag: 54025bbe-9705-4402-9e21-435893728972

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Calidad = 1.0
		lineageTag: dcb8f50e-3036-4cd3-8bb1-ef6456b777fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rendimiento =
			
			VAR MinutosOp = ([Horas Trabajadas] * 60) - [Min Paro]
			VAR ProduccionReal = [Pacas Producidas]
			-- Si la capacidad en tu proceso es por HORA (ej. 120 pacas/hora = 2 pacas/minuto):
			VAR CapacidadPorMinuto = 1.0  -- Prueba con 1.0 o con la tasa real de pacas por minuto
			VAR ProduccionEsperada = MinutosOp * CapacidadPorMinuto
			RETURN
			IF(
			    ISBLANK(MinutosOp) || MinutosOp <= 0,
			    0,
			    DIVIDE(ProduccionReal, ProduccionEsperada, 0)
			)
		lineageTag: 4be8724c-025c-4cdb-9f36-529519b6080c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure OEE = [Disponibilidad] * [Rendimiento] * [Calidad]
		lineageTag: 42a93c08-bdea-461b-b0e4-6ac53c696497

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Acumulado Pareto' = ```
			
			VAR TotalMinutosSeleccionados = CALCULATE([Min Paro], ALLSELECTED(dim_causa_paro))
			VAR MinutosFallaActual = [Min Paro]
			VAR TablaRanking = 
			    ADDCOLUMNS(
			        ALLSELECTED(dim_causa_paro[codigo_nombre]),
			        "@Minutos", [Min Paro]
			    )
			RETURN
			IF(
			    ISBLANK([Min Paro]),
			    BLANK(),
			    DIVIDE(
			        SUMX(
			            FILTER(TablaRanking, [@Minutos] >= MinutosFallaActual),
			            [@Minutos]
			        ),
			        TotalMinutosSeleccionados,
			        0
			    )
			)
			```
		lineageTag: e7e76e4f-42ec-4d20-9dcb-2f6034eb24d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
		isHidden
		formatString: 0
		lineageTag: acd92237-cef5-428d-afec-1b481ae8a4e6
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Medidas = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = e85e682ec46a445e80fe0ac7fac60668

