      "panel-1": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Pacas por máquina",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "datasource": {
                        "name": "PostgreSQL_BI"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT \n  d.fecha::timestamp AS \"time\", \n  m.nombre AS metric, \n  f.pacas_producidas AS value\nFROM dw.fact_produccion_turno f\nJOIN dw.dim_fecha d USING (fecha_key)\nJOIN dw.dim_maquina m USING (maquina_key)\nJOIN dw.dim_turno t USING (turno_key)\nWHERE d.fecha >= $__timeFrom()::date \n  AND d.fecha <= $__timeTo()::date\n  AND m.nombre IN (${maquina:singlequote})\n  AND t.descripcion IN (${turno:singlequote})\nORDER BY 1;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
