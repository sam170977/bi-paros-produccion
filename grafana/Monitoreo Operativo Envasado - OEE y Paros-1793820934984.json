                        "rawQuery": true,
                        "rawSql": "SELECT \n  d.fecha AS \"Fecha\", \n  m.nombre AS \"Máquina\", \n  p.*\nFROM dw.fact_paro p\nJOIN dw.dim_fecha d USING (fecha_key)\nJOIN dw.dim_maquina m USING (maquina_key)\nWHERE d.fecha >= $__timeFrom()::date \n  AND d.fecha <= $__timeTo()::date\nORDER BY d.fecha DESC \nLIMIT 20;",
