                        "rawQuery": true,
                        "rawSql": "SELECT \n  m.nombre AS maquina, \n  ROUND(\n    AVG(\n      CASE \n        WHEN COALESCE(f.horas_trabajadas, 0) > 0 \n        THEN GREATEST(0.0, LEAST(100.0, 100.0 * (1.0 - (COALESCE(f.min_paro_oee, 0)::numeric / (f.horas_trabajadas * 60.0)::numeric))))\n        ELSE 100.0 \n      END\n    ), 2\n  ) AS disponibilidad\nFROM dw.fact_produccion_turno f\nJOIN dw.dim_fecha d USING (fecha_key)\nJOIN dw.dim_maquina m USING (maquina_key)\nJOIN dw.dim_turno t USING (turno_key)\nWHERE d.fecha >= $__timeFrom()::date \n  AND d.fecha <= $__timeTo()::date\n  AND m.nombre IN (${maquina:singlequote})\n  AND t.descripcion IN (${turno:singlequote})\nGROUP BY m.nombre;",
