      "panel-2": {
        "kind": "Panel",
        "spec": {
          "id": 2,
          "title": "Disponibilidad por máquina (%)",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "postgres",
                      "version": "v0",
                      "datasource": {
                        "name": "PostgreSQL_BI"
                      },
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "SELECT \n  d.fecha::timestamp AS \"time\", \n  m.nombre AS metric, \n  ROUND(\n    AVG(\n      CASE \n        WHEN COALESCE(f.horas_trabajadas, 0) > 0 \n        THEN GREATEST(0.0, LEAST(100.0, 100.0 * (1.0 - (COALESCE(f.min_paro_oee, 0)::numeric / (f.horas_trabajadas * 60.0)::numeric))))\n        ELSE 100.0 \n      END\n    ), 2\n  ) AS value\nFROM dw.fact_produccion_turno f\nJOIN dw.dim_fecha d USING (fecha_key)\nJOIN dw.dim_maquina m USING (maquina_key)\nJOIN dw.dim_turno t USING (turno_key)\nWHERE d.fecha >= $__timeFrom()::date \n  AND d.fecha <= $__timeTo()::date\n  AND m.nombre IN (${maquina:singlequote})\n  AND t.descripcion IN (${turno:singlequote})\nGROUP BY d.fecha, m.nombre\nORDER BY 1;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
